# ============================================================
# Frontend Environment Variables
# Copy this file to .env for local development.
# NEVER commit your real .env to Git.
# ============================================================

# ── Local Development ─────────────────────────────────────
# Vite proxies every /api/* request to the Express backend.
# Leave this as /api for local dev — the proxy handles routing.
VITE_API_URL=/api

# The host that Vite's dev-server proxy forwards /api/* requests to.
# Change this if your backend runs on a different port.
VITE_DEV_API_TARGET=http://localhost:5000

# ── Production (Vercel) ───────────────────────────────────
# With the new Vercel monorepo configuration (root vercel.json), 
# your backend runs on the exact same domain as your frontend.
#
# Therefore, VITE_API_URL can just remain /api, and you do not
# need to set it in the Vercel dashboard. The proxy handles it locally,
# and the Vercel routing handles it in production!
VITE_API_URL=/api
