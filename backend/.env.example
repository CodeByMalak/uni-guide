# Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file to Git.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Use a long, random string in production.
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Local development frontend origin.
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated list for custom production domains.
# Vercel *.vercel.app URLs are already allowed by backend/server.js.
# FRONTEND_URLS=https://your-custom-domain.com

# Vercel production variables:
# MONGO_URI=your_mongodb_atlas_connection_string
# JWT_SECRET=your_long_random_secret
# NODE_ENV=production
