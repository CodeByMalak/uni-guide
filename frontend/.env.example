# ============================================================
# Frontend Environment Variables
# Copy this file to .env for local development.
# NEVER commit your real .env to Git.
# ============================================================

# ── Local Development ─────────────────────────────────────
# Vite proxies every /api/* request to the Express backend.
# Leave this as /api for local dev — the proxy handles routing.
VITE_API_URL=/api

# The host that Vite's dev-server proxy forwards /api/* requests to.
# Change this if your backend runs on a different port.
VITE_DEV_API_TARGET=http://localhost:5000

# ── Production (Vercel) ───────────────────────────────────
# Set VITE_API_URL in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
#   Key:   VITE_API_URL
#   Value: https://your-backend.onrender.com/api
#
# This tells the deployed frontend where to send API requests.
# Without this, every API call returns 404 on Vercel.
#
# Steps:
# 1. Deploy backend to Render (or Railway)
# 2. Copy the deployed URL (e.g. https://uni-guide-api.onrender.com)
# 3. Paste it into Vercel as: VITE_API_URL=https://uni-guide-api.onrender.com/api
# 4. Redeploy on Vercel — all API calls will now work.
