# ============================================================
# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # set to "production" on Render/Railway

# ── MongoDB Atlas ─────────────────────────────────────────
# Preferred format (Atlas SRV — copy from Atlas dashboard → Connect):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Use a long, random string in production (min 32 chars recommended):
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ── CORS / Allowed Frontend Origins ───────────────────────
# Local development (always allowed by default):
FRONTEND_URL=http://localhost:5173

# Production: your Vercel deployment URL (no trailing slash).
# Note: ALL *.vercel.app and *.netlify.app URLs are already allowed
# by wildcard in server.js, so this is only needed for custom domains.
# FRONTEND_URLS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Deployment: Render ────────────────────────────────────
# When deploying to Render, set these in the Render dashboard:
#   PORT        → Render sets this automatically, leave blank
#   MONGO_URI   → Your Atlas connection string
#   JWT_SECRET  → A long random secret
#   NODE_ENV    → production
#   FRONTEND_URLS → https://your-app.vercel.app (if using custom domain)
